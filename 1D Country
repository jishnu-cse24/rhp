// 1D Country

#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    vector<long long> X(N), P(N);
    for (auto &x : X) cin >> x;
    for (auto &p : P) cin >> p;

    vector<long long> prefix(N + 1, 0);

    for (int i = 0; i < N; i++)
        prefix[i + 1] = prefix[i] + P[i];

    int Q;
    cin >> Q;

    while (Q--) {
        long long L, R;
        cin >> L >> R;

        int left = lower_bound(X.begin(), X.end(), L) - X.begin();
        int right = upper_bound(X.begin(), X.end(), R) - X.begin();

        cout << prefix[right] - prefix[left] << '\n';
    }

    return 0;
}