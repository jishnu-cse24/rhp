// Longest Subarray With Equal 0 and 1

#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    unordered_map<int, int> first;

    first[0] = -1;

    int sum = 0;
    int answer = 0;

    for (int i = 0; i < N; i++) {
        int x;
        cin >> x;

        if (x == 0)
            sum--;
        else
            sum++;

        if (first.count(sum)) {
            answer = max(answer, i - first[sum]);
        }
        else {
            first[sum] = i;
        }
    }

    cout << answer << '\n';

    return 0;
}