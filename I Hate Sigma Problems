// I Hate Sigma Problems

#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    vector<int> A(N);

    for (int &x : A)
        cin >> x;

    vector<long long> last(N + 1, 0);

    long long current = 0;
    long long answer = 0;

    for (int i = N - 1; i >= 0; i--) {

        current -= last[A[i]];

        last[A[i]] = N - i;

        current += last[A[i]];

        answer += current;
    }

    cout << answer << '\n';

    return 0;
}