#include <bits/stdc++.h>
using namespace std;

int main() {

    int T;
    cin >> T;

    while (T--) {

        int n, m;
        cin >> n >> m;

        vector<vector<int>> graph(n + 1);

        for (int i = 0; i < m; i++) {

            int u, v;
            cin >> u >> v;

            graph[u].push_back(v);
            graph[v].push_back(u);
        }

        int start;
        cin >> start;

        vector<int> dist(n + 1, -1);

        queue<int> q;
        q.push(start);
        dist[start] = 0;

        while (!q.empty()) {

            int u = q.front();
            q.pop();

            for (int v : graph[u]) {

                if (dist[v] == -1) {

                    dist[v] = dist[u] + 6;
                    q.push(v);
                }
            }
        }

        for (int i = 1; i <= n; i++) {

            if (i == start)
                continue;

            cout << dist[i] << " ";
        }

        cout << '\n';
    }

    return 0;
}
