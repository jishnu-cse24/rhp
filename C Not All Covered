// C Not All Covered

#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N, T;
    cin >> N >> T;

    vector<int> diff(N + 2, 0);

    while (T--) {
        int L, R;
        cin >> L >> R;

        diff[L]++;
        diff[R + 1]--;
    }

    int current = 0;
    int answer = INT_MAX;

    for (int i = 1; i <= N; i++) {
        current += diff[i];

        answer = min(answer, current);
    }

    cout << answer << '\n';

    return 0;
}