// Disjoint Set

#include <bits/stdc++.h>
using namespace std;

class DSU {
    vector<int> parent;

public:
    DSU(int n) {
        parent.resize(n + 1);
        iota(parent.begin(), parent.end(), 0);
    }

    int find(int x) {
        if (parent[x] == x)
            return x;

        return parent[x] = find(parent[x]);
    }

    void unite(int a, int b) {
        a = find(a);
        b = find(b);

        if (a != b)
            parent[a] = b;
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N, M;
    cin >> N >> M;

    DSU dsu(N);

    for (int i = 0; i < M; i++) {
        int a, b;
        cin >> a >> b;

        dsu.unite(a, b);
    }

    for (int i = 1; i <= N; i++)
        cout << dsu.find(i) << ' ';

    cout << '\n';

    return 0;
}